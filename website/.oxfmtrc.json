{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "ignorePatterns": [
    "node_modules/**",
    ".vitepress/cache/**",
    ".vitepress/dist/**",
    "pnpm-lock.yaml"
  ],
  "printWidth": 100,
  "proseWrap": "always",
  "semi": false,
  "singleQuote": true,
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false
}
