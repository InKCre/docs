{
  "name": "@inkcre/docs-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vitepress build",
    "check": "pnpm format:check && pnpm build && pnpm verify:build",
    "dev": "vitepress dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "vitepress preview",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.60.0",
    "vitepress": "2.0.0-alpha.18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.22.3",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.17.0"
}
