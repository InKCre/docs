{
  "name": "@inkcre/docs-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vitepress build",
    "check": "pnpm format:check && pnpm test && pnpm build",
    "test": "node --test scripts/*.test.mjs",
    "dev": "vitepress dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "vitepress": "2.0.0-alpha.20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.22.3",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.17.0"
}
